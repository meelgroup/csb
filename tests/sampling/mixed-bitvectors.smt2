(set-logic QF_BV)
(declare-const choose Bool)
(declare-const spare Bool)
(declare-const x (_ BitVec 3))
(declare-const y (_ BitVec 3))
(declare-const result (_ BitVec 3))
(assert (= result (ite choose (bvadd x y) (bvsub x y))))
(assert (bvult x #b110))
(assert (not (= y #b000)))
(assert (bvslt result #b010))
(assert (= ((_ extract 0 0) result) #b1))
(check-sat)
